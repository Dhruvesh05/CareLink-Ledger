# Runtime
NODE_ENV=development
PORT=5000

# Backend API
JWT_SECRET=
MONGODB_URI=
BLOCKCHAIN_PROVIDER=ethereum

# Ethereum / EVM
ETHEREUM_NETWORK=sepolia
ETHEREUM_RPC=
PRIVATE_KEY=
ACCESS_CONTROL_ADDRESS=
PATIENT_REGISTRY_ADDRESS=
DOCTOR_REGISTRY_ADDRESS=
HOSPITAL_REGISTRY_ADDRESS=
AUDIT_LOG_ADDRESS=
MEDICAL_RECORD_ADDRESS=

# Polygon
POLYGON_NETWORK=amoy
POLYGON_RPC=

# Hardhat / deployments
ALCHEMY_SEPOLIA_URL=
ALCHEMY_AMOY_URL=
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=

# IPFS / Pinata
PINATA_API_KEY=
PINATA_SECRET_KEY=
PINATA_JWT=
IPFS_HOST=127.0.0.1
IPFS_PORT=5001
IPFS_PROTOCOL=http
IPFS_TIMEOUT_MS=12000
IPFS_MAX_UPLOAD_SIZE_BYTES=10485760
IPFS_ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg

# SSI
SSI_DATABASE=ssi.sqlite
SSI_SECRET_KEY=
DID_NETWORK=polygon-amoy

# FHIR
FHIR_SERVER_URL=http://localhost:8080/fhir

# Fabric
FABRIC_CHANNEL=mychannel
FABRIC_CHAINCODE=ehr-chaincode
FABRIC_MSP=

# Compatibility aliases used by scripts/config
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=ehr-chaincode