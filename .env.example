# CareLink Ledger environment template

NODE_ENV=development
APP_NAME=CareLink Ledger
APP_PORT=3000

# Security
JWT_SECRET=
JWT_EXPIRES_IN=1d

# MongoDB
MONGODB_URI=
MONGODB_DB=carelink

# Pinata / IPFS
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud

# Ethereum Sepolia
ALCHEMY_SEPOLIA_URL=
ETHEREUM_SEPOLIA_RPC_URL=
ETHEREUM_SEPOLIA_CHAIN_ID=11155111
ETHEREUM_SEPOLIA_PRIVATE_KEY=
ETHEREUM_SEPOLIA_DEPLOYER_ADDRESS=
EHR_REGISTRY_SEPOLIA=
EHR_ACCESS_SEPOLIA=

# Polygon Amoy
ALCHEMY_AMOY_URL=
POLYGON_AMOY_RPC_URL=
POLYGON_AMOY_CHAIN_ID=80002
POLYGON_AMOY_PRIVATE_KEY=
POLYGON_AMOY_DEPLOYER_ADDRESS=
EHR_REGISTRY_AMOY=
EHR_ACCESS_AMOY=

# Bridge
BRIDGE_PORT=4000
BRIDGE_RELAY_INTERVAL_MS=5000
BRIDGE_SIGNATURE_THRESHOLD=2
BRIDGE_PRIVATE_KEY=
BRIDGE_API_KEY=
BRIDGE_ETHEREUM_CONTRACT_ADDRESS=
BRIDGE_POLYGON_CONTRACT_ADDRESS=

# Backend
BACKEND_PORT=5000
BACKEND_BASE_URL=http://localhost:5000
BACKEND_CORS_ORIGIN=http://localhost:3000

# Analytics
ANALYTICS_PORT=8000
ANALYTICS_BASE_URL=http://localhost:8000
ANALYTICS_MODEL_PATH=

# FHIR
FHIR_BASE_URL=http://localhost:8080/fhir
FHIR_SERVER_URL=http://localhost:8080/fhir
FHIR_USERNAME=
FHIR_PASSWORD=
FHIR_CLIENT_ID=
FHIR_CLIENT_SECRET=

# Hyperledger Fabric
FABRIC_NETWORK_NAME=carelink-network
FABRIC_CHANNEL_NAME=carelinkchannel
FABRIC_CHAINCODE_NAME=ehr-chaincode
FABRIC_ORG1_MSP_ID=
FABRIC_ORG2_MSP_ID=
FABRIC_PEER_ADDRESS=
FABRIC_ORDERER_ADDRESS=
FABRIC_CA_URL=
FABRIC_WALLET_PATH=

# Docker / deployment
DOCKER_COMPOSE_PROJECT_NAME=carelink
DEPLOYMENT_ENV=local
OCI_REGION=
OCI_COMPARTMENT_OCID=
OCI_TENANCY_OCID=
OCI_BUCKET_NAME=

# CI/CD
GITHUB_TOKEN=
CI_ENVIRONMENT=local